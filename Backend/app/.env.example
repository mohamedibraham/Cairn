ENV=development                         # development | production

#  Database 
DATABASE_URL=postgresql+psycopg2://<USER>:<PASSWORD>@<HOST>:5432/<DB_NAME>

# JWT 
JWT_SECRET_KEY=<generate: openssl rand -hex 32>
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=30

#  CORS 
CORS_ALLOWED_ORIGINS='["http://localhost:5173"]'

#  File Storage 
STORAGE_BASE_PATH=storage/uploads
MAX_UPLOAD_SIZE_MB=50

#  Embeddings 
EMBEDDING_DIM=768
EMBEDDING_MODEL_NAME=intfloat/multilingual-e5-base
EMBEDDING_CACHE_DIR=storage/embeddingcache
EMBEDDING_BATCH_SIZE=32
EMBEDDING_DOC_PREFIX=passage: 
EMBEDDING_QUERY_PREFIX=query: 

CHUNK_SIZE_TOKENS=400
CHUNK_OVERLAP_TOKENS=60

LOG_LEVEL=INFO                          # DEBUG | INFO | WARNING | ERROR

#  LLM 
LLM_PROVIDER=cohere                     # cohere | gemini | openai
LLM_MODEL=command-r-plus-08-2024
LLM_TEMPERATURE=0.2
LLM_MAX_OUTPUT_TOKENS=2048
LLM_TIMEOUT_SECONDS=45
LLM_MAX_RETRIES=2
LLM_RETRY_BASE_DELAY=2.0
LLM_MAX_RETRY_WAIT=60.0
LLM_MAX_CONCURRENCY=4
LLM_REQUESTS_PER_MINUTE=0              

LLM_FALLBACK_PROVIDER=gemini
LLM_FALLBACK_MODEL=gemini-2.5-flash

# Provider Credentials 
COHERE_API_KEY=<your-cohere-api-key>
GEMINI_API_KEY=<your-gemini-api-key>


