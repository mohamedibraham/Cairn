# Compose-level variables (read automatically from infrastructure/.env). Git-ignore the real file.
# Single source of truth for the database credentials: the db container, the exporter,
# Grafana's SQL datasource and the backend's DATABASE_URL are all derived from these.
# Use URL-safe characters in the password (it is embedded in connection URLs).
# NOTE: Postgres only applies these on the FIRST start of an empty volume.
POSTGRES_USER=mohamed
POSTGRES_PASSWORD=change-me
POSTGRES_DB=caindatabase

GRAFANA_ADMIN_USER=admin
GRAFANA_ADMIN_PASSWORD=change-me
